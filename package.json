{
  "name": "dsh-claude-mem",
  "version": "0.3.1",
  "private": true,
  "description": "Cross-project memory for DeepSeek Harness: index-only injection, selective recall, two-tier (global + workspace) SQLite storage. Zero third-party runtime deps.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**",
    "tools/mem-admin.mjs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "load-check": "node tools/load-check.mjs",
    "mutex-check": "node tools/check-default-disabled.mjs",
    "rehearsal": "node tools/rehearsal/run-rehearsal.mjs",
    "admin": "node tools/mem-admin.mjs",
    "bench": "node tools/bench-memory.mjs",
    "bench:data": "node tools/bench/devmem/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
